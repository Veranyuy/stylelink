# ========================
# Sensitive & Environment
# ========================

# Environment files
.env
.env.*
!.env.example

# Supabase local CLI
supabase/.temp/
supabase/.env

# Firebase — keep .firebaserc and firebase.json for hosting config,
# but ignore service account keys and local debug files.
# firebase_options.dart IS committed (contains public web config only).
*-service-account*.json
*-credentials*.json
google-services.json
GoogleService-Info.plist

# Freebuff internal files (dev tooling, logs, databases)
.freebuff/

# Temporary fix scripts (created during development, not part of the app)
_fix_*.js
_write_*.js
start_server.js

# Node modules (if any local tooling is added)
node_modules/

# Build artifacts
build/
.dart_tool/

# Platform-specific generated files (regenerated by flutterfire configure)
# Uncomment if you want to regenerate these locally:
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist
# lib/firebase_options.dart
